{
  "expo": {
    "name": "Medicacion",
    "slug": "medicacion",
    "scheme": "atiempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atiempo.medicacion"
    },
    "android": {
      "package": "com.atiempo.medicacion",
      "adaptiveIcon": {
        "backgroundColor": "#30473B",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#30473B" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
