{
  "expo": {
    "name": "Medicacion",
    "slug": "medicacion",
    "scheme": "atiempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atiempo.medicacion"
    },
    "android": {
      "package": "com.atiempo.medicacion",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#30473B",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#30473B"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permití usar la cámara para fotografiar un medicamento.",
          "photosPermission": "Permití elegir una foto para identificar un medicamento.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permití elegir un contacto para asociarlo a un medicamento."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Permití guardar la próxima toma en el calendario del dispositivo."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
